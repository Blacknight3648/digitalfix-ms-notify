# ==========================================================
# Variables de entorno - digitalfix-ms-notify (Plantilla)
# ==========================================================

# --- Configuración del Microservicio ---
PORT=8083
SERVER_PORT=8083

# --- Configuración de Conexión a RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VIRTUAL_HOST=/

# --- Configuración del Servidor SMTP (JavaMailSender - Brevo) ---
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu_usuario_smtp_brevo
SPRING_MAIL_PASSWORD=tu_clave_smtp_brevo
APP_MAIL_FROM=notificaciones@tudominio.com
