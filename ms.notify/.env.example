# ==========================================================
# Variables de entorno - digitalfix-ms-notify (Plantilla)
# ==========================================================

# --- Configuración del Microservicio ---
PORT=8083
SERVER_PORT=8083

# --- Base de datos Oracle Autonomous (con wallet) ---
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@<alias>_high?TNS_ADMIN=./wallet
SPRING_DATASOURCE_USERNAME=<usuario_bd>
SPRING_DATASOURCE_PASSWORD=<contrasena_bd>

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Configuración de Conexión a RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VIRTUAL_HOST=/

# --- Configuración del Servidor SMTP (JavaMailSender) ---
SPRING_MAIL_HOST=smtp.mailtrap.io
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=tu_usuario_smtp
SPRING_MAIL_PASSWORD=tu_password_smtp
